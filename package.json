{
  "name": "digital-decluttering-agent",
  "version": "1.0.0",
  "description": "Intelligent file analysis and cleanup tool with interactive web dashboard for macOS",
  "author": "Adrian Solomone",
  "license": "MIT",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --mac",
    "build:universal": "electron-builder --mac --universal",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "generate-icons": "node scripts/generate-icons.js",
    "postinstall": "npm run generate-icons"
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "png2icons": "^2.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adriansolomone/digital-decluttering-agent.git"
  },
  "keywords": [
    "file-cleanup",
    "disk-space",
    "macos",
    "file-management",
    "declutter",
    "ibm-design"
  ],
  "build": {
    "appId": "com.adriansolomone.digitalclutter",
    "productName": "Digital Decluttering Agent",
    "copyright": "Copyright © 2024 Adrian Solomone",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Digital Decluttering Agent ${version}",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "package.json",
      "dashboard/**/*",
      "reports/**/*",
      "logs/**/*",
      "file_scanner_user_only.py",
      "requirements.txt",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}